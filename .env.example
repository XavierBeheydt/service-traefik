# Copy to .env and fill in (`just env` does the copy). .env is git-ignored.
# The defaults below are for local testing; see README.md for production.

# Base domain; the dashboard is served on traefik.<DOMAIN>.
# Locally, *.docker.localhost resolves to 127.0.0.1 without any DNS setup.
DOMAIN=docker.localhost

# Certificate resolver used by default on HTTPS routers:
# - empty: local certificate generated by `just certs` (local testing)
# - le:    Let's Encrypt (production, DNS records must point to the VPS)
TLS_CERT_RESOLVER=

# Email used for the Let's Encrypt account (only used when TLS_CERT_RESOLVER=le)
ACME_EMAIL=admin@example.com

# Host ports; change them locally if 80/443 are already taken
HTTP_PORT=80
HTTPS_PORT=443

# Dashboard basic auth, generated with: htpasswd -nB admin
# Keep the single quotes so the `$` in the hash are not interpolated.
# The default is admin/admin, for local testing only: replace it in production.
TRAEFIK_DASHBOARD_USERS='admin:$apr1$localdev$UBJzEHbFoB3v1pV4Hb2bx/'
