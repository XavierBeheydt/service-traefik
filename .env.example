# Copy to .env and fill in. .env is git-ignored.

# Base domain; the dashboard is served on traefik.<DOMAIN>
DOMAIN=example.com

# Email used for the Let's Encrypt account (expiry notices)
ACME_EMAIL=admin@example.com

# Dashboard basic auth, generated with: htpasswd -nB admin
# Keep the single quotes so the `$` in the hash are not interpolated.
TRAEFIK_DASHBOARD_USERS='admin:$2y$05$replace.with.your.bcrypt.hash'
